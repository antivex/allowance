{
  "name": "allowance",
  "version": "0.1.0",
  "description": "Give your AI agent an allowance, not your wallet. A policy wallet between any AI agent and PayPal.",
  "license": "MIT",
  "author": "antivex",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "start": "npm run build && node --disable-warning=ExperimentalWarning dist/server/index.js",
    "serve": "node --disable-warning=ExperimentalWarning dist/server/index.js",
    "dev": "concurrently -k -n api,web -c blue,magenta \"tsx watch server/src/index.ts\" \"vite\"",
    "mcp": "node --disable-warning=ExperimentalWarning dist/server/mcp/stdio.js",
    "demo": "tsx demo/agent.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.web.json",
    "eval:ai": "tsx scripts/eval-ai.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ag-grid-community": "^36.2.0",
    "ag-grid-react": "^36.2.0",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
