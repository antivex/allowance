# Allowance configuration. `npm run setup` copies this file to .env if .env does not exist.
# Every line is optional. Without PayPal credentials, Allowance runs a clearly labelled offline simulation.

# PayPal sandbox REST app: developer.paypal.com > Apps & Credentials > Sandbox > your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# The currency of your sandbox business account (USD for a US account, EUR for an Italian one, ...)
CURRENCY=USD

# AI: any OpenAI-compatible endpoint. The default is local Ollama.
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=qwen3.5:4b
AI_API_KEY=ollama
# "none" turns off slow thinking on reasoning models. Leave empty for providers that reject the field.
AI_REASONING_EFFORT=none
AI_TIMEOUT_MS=30000
# If the AI review does not answer: "ask" sends would-be approvals to you, "keep" trusts the rules alone.
AI_ON_FAILURE=ask
# AI_ENABLED=false

# Server
PORT=4000
# PUBLIC_URL=http://localhost:4000
# Minutes you have to approve a held purchase before PayPal voids the hold (max 4320 = 3 days)
HOLD_TIMEOUT_MINUTES=1440
# The demo shop with the poisoned product page. 0 turns it off.
SHOP_PORT=4100
